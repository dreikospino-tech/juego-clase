# ---------------------------------------------------------------- NIVELES
LEVELS = [
    dict(enemies=2, speed=58, density=0.50, power=2),
    dict(enemies=3, speed=76, density=0.60, power=2),
    dict(enemies=4, speed=94, density=0.68, power=2),
]

EXIT_C, EXIT_R = COLS - 2, ROWS - 2
EXIT_RECT = pygame.Rect(EXIT_C * TILE, EXIT_R * TILE, TILE, TILE)


# ---------------------------------------------------------------- UTILIDADES
def tiles_overlapping(rect):
    c0 = max(0, rect.left // TILE)
    c1 = min(COLS - 1, (rect.right - 1) // TILE)
    r0 = max(0, rect.top // TILE)
    r1 = min(ROWS - 1, (rect.bottom - 1) // TILE)
    for r in range(r0, r1 + 1):
        for c in range(c0, c1 + 1):
            yield c, r


def rect_collides(rect, grid):
    for c, r in tiles_overlapping(rect):
        if grid[r][c] in (1, 2):
            return True
    return False


def resolve_x(rect, dx, grid):
    if dx == 0:
        return
    hits = [c for c, r in tiles_overlapping(rect) if grid[r][c] in (1, 2)]
    if not hits:
        return
    if dx > 0:
        rect.right = min(hits) * TILE
    else:
        rect.left = (max(hits) + 1) * TILE


def resolve_y(rect, dy, grid):
    if dy == 0:
        return
    hits = [r for c, r in tiles_overlapping(rect) if grid[r][c] in (1, 2)]
    if not hits:
        return
    if dy > 0:
        rect.bottom = min(hits) * TILE
    else:
        rect.top = (max(hits) + 1) * TILE


def generate_map(density):
    """1 = muro fijo, 2 = bloque destructible, 0 = suelo."""
    grid = [[0] * COLS for _ in range(ROWS)]
    for r in range(ROWS):
        for c in range(COLS):
            if r == 0 or r == ROWS - 1 or c == 0 or c == COLS - 1:
                grid[r][c] = 1
            elif r % 2 == 0 and c % 2 == 0:
                grid[r][c] = 1

    protected = {(1, 1), (2, 1), (1, 2), (EXIT_C, EXIT_R)}
    for r in range(1, ROWS - 1):
        for c in range(1, COLS - 1):
            if grid[r][c] == 0 and (c, r) not in protected:
                if random.random() < density:
                    grid[r][c] = 2
    return grid


def pick_enemy_spawns(grid, n):
    def cands(min_d):
        out = []
        for r in range(1, ROWS - 1):
            for c in range(1, COLS - 1):
                if grid[r][c] != 0:
                    continue
                if (c, r) == (EXIT_C, EXIT_R):
                    continue
                if abs(c - 1) + abs(r - 1) >= min_d:
                    out.append((c, r))
        return out

    for min_d in (9, 7, 5, 3):
        lst = cands(min_d)
        if len(lst) >= n:
            random.shuffle(lst)
            return lst[:n]

    lst = cands(1)
    random.shuffle(lst)
    while len(lst) < n:
        lst.append((1, 1))
    return lst[:n]


# ---------------------------------------------------------------- ENTIDADES
class Player:
    def __init__(self, col, row):
        self.rect = pygame.Rect(0, 0, 26, 26)
        self.rect.center = (col * TILE + TILE // 2, row * TILE + TILE // 2)
        self.px = float(self.rect.x)
        self.py = float(self.rect.y)
        self.speed = 152.0
        self.power = 2
        self.max_bombs = 1

    def update(self, dt, grid):
        keys = pygame.key.get_pressed()
        dx = dy = 0.0
        if keys[pygame.K_LEFT] or keys[pygame.K_a]:
            dx -= 1
        if keys[pygame.K_RIGHT] or keys[pygame.K_d]:
            dx += 1
        if keys[pygame.K_UP] or keys[pygame.K_w]:
            dy -= 1
        if keys[pygame.K_DOWN] or keys[pygame.K_s]:
            dy += 1
        if dx and dy:
            dx *= 0.7071
            dy *= 0.7071

        self.px += dx * self.speed * dt
        self.rect.x = round(self.px)
        resolve_x(self.rect, dx, grid)
        self.px = float(self.rect.x)

        self.py += dy * self.speed * dt
        self.rect.y = round(self.py)
        resolve_y(self.rect, dy, grid)
        self.py = float(self.rect.y)

    def draw(self, surf):
        r = self.rect
        pygame.draw.rect(surf, C_PLAYER_D, r.inflate(6, 6), border_radius=9)
        pygame.draw.rect(surf, C_PLAYER, r, border_radius=8)
        pygame.draw.circle(surf, (18, 44, 62), (r.centerx - 5, r.centery - 3), 3)
        pygame.draw.circle(surf, (18, 44, 62), (r.centerx + 5, r.centery - 3), 3)


class Enemy:
    def __init__(self, col, row, speed):
        self.rect = pygame.Rect(0, 0, 26, 26)
        self.rect.center = (col * TILE + TILE // 2, row * TILE + TILE // 2)
        self.px = float(self.rect.x)
        self.py = float(self.rect.y)
        self.speed = float(speed)
        self.dir = random.choice([(1, 0), (-1, 0), (0, 1), (0, -1)])
        self.wobble = random.random() * 6.28

    def update(self, dt, grid):
        vx, vy = self.dir
        ox, oy = self.rect.x, self.rect.y

        self.px += vx * self.speed * dt
        self.rect.x = round(self.px)
        resolve_x(self.rect, vx, grid)
        self.px = float(self.rect.x)

        self.py += vy * self.speed * dt
        self.rect.y = round(self.py)
        resolve_y(self.rect, vy, grid)
        self.py = float(self.rect.y)

        moved = abs(self.rect.x - ox) + abs(self.rect.y - oy)
        if moved < 1:
            self.choose_dir(grid)
        elif random.random() < 0.55 * dt:
            self.choose_dir(grid)

        self.wobble += dt * 8

    def choose_dir(self, grid):
        dirs = [(1, 0), (-1, 0), (0, 1), (0, -1)]
        random.shuffle(dirs)
        rev = (-self.dir[0], -self.dir[1])
        dirs.sort(key=lambda d: d == rev)
        for d in dirs:
            probe = self.rect.move(d[0] * 8, d[1] * 8)
            if not rect_collides(probe, grid):
                self.dir = d
                return
        self.dir = rev

    def draw(self, surf):
        r = self.rect
        off = int(math.sin(self.wobble) * 1.5)
        pygame.draw.circle(surf, C_ENEMY_D, (r.centerx, r.centery + off), 15)
        pygame.draw.circle(surf, C_ENEMY, (r.centerx, r.centery + off), 12)
        pygame.draw.circle(surf, (255, 255, 255), (r.centerx - 4, r.centery - 3 + off), 3)
        pygame.draw.circle(surf, (255, 255, 255), (r.centerx + 4, r.centery - 3 + off), 3)
        pygame.draw.circle(surf, (30, 10, 16), (r.centerx - 4, r.centery - 3 + off), 1)
        pygame.draw.circle(surf, (30, 10, 16), (r.centerx + 4, r.centery - 3 + off), 1)


class Bomb:
    def __init__(self, col, row, power):
        self.col = col
        self.row = row
        self.power = power
        self.timer = 2.2
        self.total = 2.2


class Explosion:
    def __init__(self, tiles):
        self.tiles = tiles
        self.timer = 0.45
        self.total = 0.45


# ---------------------------------------------------------------- JUEGO
class Game:
    def __init__(self):
        self.state = "menu"
        self.level_index = 0
        self.score = 0
        self.lives = 3
        self.state_timer = 0.0
        self.grid = [[0] * COLS for _ in range(ROWS)]
        self.player = Player(1, 1)
        self.enemies = []
        self.bombs = []
        self.explosions = []
        self.exit_open = False
        self.start_level(0)

    # ------------------------------------------------ ciclo de nivel
    def start_level(self, idx):
        self.level_index = idx
        cfg = LEVELS[idx]
        self.grid = generate_map(cfg["density"])
        self.player = Player(1, 1)
        self.player.power = cfg["power"]
        self.player.max_bombs = 1
        self.enemies = [Enemy(c, r, cfg["speed"])
                        for (c, r) in pick_enemy_spawns(self.grid, cfg["enemies"])]
        self.bombs = []
        self.explosions = []
        self.exit_open = False
        self.state = "playing"
        self.state_timer = 0.0

    def reset_run(self):
        self.score = 0
        self.lives = 3
        self.start_level(0)

    # ------------------------------------------------ input
    def handle_key(self, key):
        if self.state == "menu":
            self.reset_run()
            return
        if self.state == "playing":
            if key == pygame.K_SPACE:
                self.place_bomb()
        elif self.state in ("gameover", "win"):
            if key in (pygame.K_r, pygame.K_RETURN, pygame.K_SPACE, pygame.K_ESCAPE):
                self.reset_run()

    def place_bomb(self):
        c = self.player.rect.centerx // TILE
        r = self.player.rect.centery // TILE
        if any(b.col == c and b.row == r for b in self.bombs):
            return
        if len(self.bombs) >= self.player.max_bombs:
            return
        self.bombs.append(Bomb(c, r, self.player.power))

    # ------------------------------------------------ update
    def update(self, dt):
        if self.state == "playing":
            self.update_playing(dt)
        elif self.state in ("dead", "clear"):
            self.state_timer -= dt
            if self.state_timer <= 0:
                if self.state == "dead":
                    if self.lives > 0:
                        self.start_level(self.level_index)
                    else:
                        self.state = "gameover"
                else:
                    if self.level_index + 1 < len(LEVELS):
                        self.start_level(self.level_index + 1)
                    else:
                        self.state = "win"

    def update_playing(self, dt):
        self.player.update(dt, self.grid)
        for e in self.enemies:
            e.update(dt, self.grid)

        # bombas
        for b in self.bombs:
            b.timer -= dt
        for b in [b for b in self.bombs if b.timer <= 0]:
            self.explode(b)

        # explosiones
        for ex in self.explosions:
            ex.timer -= dt
        self.explosions = [ex for ex in self.explosions if ex.timer > 0]

        # daño a enemigos
        surviving = []
        for e in self.enemies:
            if self.explosion_hits(e.rect):
                self.score += 50
            else:
                surviving.append(e)
        self.enemies = surviving

        if not self.enemies:
            self.exit_open = True

        # muerte del jugador
        if self.explosion_hits(self.player.rect):
            self.kill_player()
            return
        for e in self.enemies:
            if self.player.rect.colliderect(e.rect):
                self.kill_player()
                return

        # salida
        if self.exit_open and self.player.rect.colliderect(EXIT_RECT):
            self.score += 100 + self.level_index * 50
            self.state = "clear"
            self.state_timer = 1.4

    def kill_player(self):
        self.lives -= 1
        self.state = "dead"
        self.state_timer = 1.3

    def explode(self, bomb):
        if bomb not in self.bombs:
            return
        self.bombs.remove(bomb)

        tiles = [(bomb.col, bomb.row)]
        for dc, dr in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            for i in range(1, bomb.power + 1):
                c = bomb.col + dc * i
                r = bomb.row + dr * i
                if not (0 <= c < COLS and 0 <= r < ROWS):
                    break
                t = self.grid[r][c]
                if t == 1:
                    break
                if t == 2:
                    self.grid[r][c] = 0
                    self.score += 10
                    tiles.append((c, r))
                    break
                tiles.append((c, r))
                # reacción en cadena
                for other in self.bombs:
                    if other.col == c and other.row == r:
                        other.timer = min(other.timer, 0.001)

        self.explosions.append(Explosion(tiles))

    def explosion_hits(self, rect):
        for ex in self.explosions:
            for (c, r) in ex.tiles:
                if rect.colliderect(pygame.Rect(c * TILE, r * TILE, TILE, TILE)):
                    return True
        return False

    # ------------------------------------------------ dibujo
    def draw(self):
        screen.fill(C_BG)
        self.draw_map()
        self.draw_exit()
        self.draw_bombs()
        self.draw_explosions()
        for e in self.enemies:
            e.draw(screen)
        if self.state in ("playing", "clear"):
            self.player.draw(screen)
        self.draw_hud()
        self.draw_overlays()

    def draw_map(self):
        for r in range(ROWS):
            for c in range(COLS):
                x, y = c * TILE, r * TILE
                t = self.grid[r][c]
                if t == 1:
                    pygame.draw.rect(screen, C_WALL, (x, y, TILE, TILE))
                    pygame.draw.rect(screen, C_WALL_HL, (x + 3, y + 3, TILE - 6, 7))
                    pygame.draw.rect(screen, (16, 18, 24), (x, y, TILE, TILE), 1)
                elif t == 2:
                    pygame.draw.rect(screen, (90, 56, 34), (x + 2, y + 2, TILE - 4, TILE - 4),
                                     border_radius=5)
                    pygame.draw.rect(screen, C_BLOCK, (x + 3, y + 3, TILE - 6, TILE - 6),
                                     border_radius=4)
                    pygame.draw.rect(screen, C_BLOCK_HL, (x + 9, y + 9, TILE - 18, TILE - 18),
                                     border_radius=3)
                else:
                    col = C_FLOOR_A if (r + c) % 2 == 0 else C_FLOOR_B
                    pygame.draw.rect(screen, col, (x, y, TILE, TILE))

    def draw_exit(self):
        if not self.exit_open:
            return
        pulse = int(3 * (1 + math.sin(pygame.time.get_ticks() * 0.006)))
        rect = EXIT_RECT.inflate(-8, -8)
        pygame.draw.rect(screen, (30, 90, 55), rect.inflate(pulse, pulse), border_radius=8)
        pygame.draw.rect(screen, C_EXIT, rect, border_radius=6)
        pygame.draw.rect(screen, (230, 255, 235), rect.inflate(-14, -14), border_radius=4)

    def draw_bombs(self):
        t = pygame.time.get_ticks() * 0.02
        for b in self.bombs:
            cx = b.col * TILE + TILE // 2
            cy = b.row * TILE + TILE // 2
            frac = max(0.0, b.timer / b.total)
            pulse = math.sin(t * (1.5 + (1 - frac) * 4)) * 2
            radius = int(12 + pulse + (1 - frac) * 2)
            pygame.draw.circle(screen, (60, 60, 74), (cx, cy), radius + 2)
            pygame.draw.circle(screen, C_BOMB, (cx, cy), radius)
            fuse = C_FUSE if int(t * 3) % 2 == 0 else (255, 90, 40)
            pygame.draw.circle(screen, fuse, (cx, cy - radius - 3), 3)

    def draw_explosions(self):
        for ex in self.explosions:
            k = max(0.0, ex.timer / ex.total)
            for (c, r) in ex.tiles:
                rect = pygame.Rect(c * TILE + 2, r * TILE + 2, TILE - 4, TILE - 4)
                pygame.draw.rect(screen, C_EXPLO2, rect, border_radius=9)
                inner = rect.inflate(-int(6 + 8 * k), -int(6 + 8 * k))
                if inner.width > 2 and inner.height > 2:
                    pygame.draw.rect(screen, C_EXPLO, inner, border_radius=7)

    def draw_hud(self):
        pygame.draw.rect(screen, (16, 18, 24), (0, PLAY_H, WIDTH, HUD_H))
        pygame.draw.line(screen, (62, 70, 90), (0, PLAY_H), (WIDTH, PLAY_H), 2)

        txt = F_SM.render(f"NIVEL {self.level_index + 1}/{len(LEVELS)}", True, C_TEXT)
        screen.blit(txt, (16, PLAY_H + 20))

        txt = F_SM.render(f"PUNTOS {self.score}", True, C_TEXT)
        screen.blit(txt, (170, PLAY_H + 20))

        txt = F_SM.render(f"ENEMIGOS {len(self.enemies)}", True,
                          C_ENEMY if self.enemies else C_EXIT)
        screen.blit(txt, (330, PLAY_H + 20))

        txt = F_SM.render(f"VIDAS {self.lives}", True, C_PLAYER)
        screen.blit(txt, (510, PLAY_H + 20))

    def draw_overlays(self):
        if self.state == "playing":
            return
        if self.state == "menu":
            self.overlay([
                ("BOMBIX", F_BIG, C_PLAYER),
                ("", F_SM, C_TEXT),
                ("Pulsa cualquier tecla para empezar", F_SM, C_TEXT),
                ("", F_SM, C_TEXT),
                ("Flechas / WASD  ->  moverte", F_SM, C_DIM),
                ("ESPACIO  ->  poner bomba", F_SM, C_DIM),
                ("Rompe bloques, elimina a los enemigos", F_SM, C_DIM),
                ("y llega a la salida verde.", F_SM, C_DIM),
            ])
        elif self.state == "dead":
            self.overlay([
                ("¡BOOM! Has caído", F_MED, C_ENEMY),
                (f"Vidas restantes: {self.lives}", F_SM, C_TEXT),
            ])
        elif self.state == "clear":
            self.overlay([
                (f"¡Nivel {self.level_index + 1} superado!", F_MED, C_EXIT),
                (f"Puntos: {self.score}", F_SM, C_TEXT),
            ])
        elif self.state == "gameover":
            self.overlay([
                ("GAME OVER", F_BIG, C_ENEMY),
                (f"Puntuación final: {self.score}", F_MED, C_TEXT),
                ("Pulsa R para volver a intentarlo", F_SM, C_DIM),
            ])
        elif self.state == "win":
            self.overlay([
                ("¡HAS GANADO!", F_BIG, C_EXIT),
                (f"Puntuación final: {self.score}", F_MED, C_TEXT),
                ("Eres el rey de las bombas.", F_SM, C_DIM),
                ("Pulsa R para jugar de nuevo", F_SM, C_DIM),
            ])

    def overlay(self, lines):
        shade = pygame.Surface((WIDTH, PLAY_H), pygame.SRCALPHA)
        shade.fill((6, 8, 14, 190))
        screen.blit(shade, (0, 0))

        total = sum(f.render(t, True, c).get_height() + 8 for t, f, c in lines)
        y = PLAY_H // 2 - total // 2
        for text, font, color in lines:
            img = font.render(text, True, color)
            screen.blit(img, (WIDTH // 2 - img.get_width() // 2, y))
            y += img.get_height() + 8


# ---------------------------------------------------------------- MAIN
def main():
    game = Game()
    running = True
    while running:
        dt = clock.tick(60) / 1000.0
        dt = min(dt, 0.05)

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE and game.state == "menu":
                    running = False
                game.handle_key(event.key)

        game.update(dt)
        game.draw()
        pygame.display.flip()

    pygame.quit()
    sys.exit()


if __name__ == "__main__":
    main()
