def make_sound(freq, duration, volume=0.3, wave="square"):
    sample_rate = 22050
    n = int(sample_rate * duration)
    buf = bytearray()
    for i in range(n):
        t = i / sample_rate
        env = min(1.0, i / (sample_rate * 0.01)) * (1.0 - i / n)
        if wave == "square":
            val = 1 if (t * freq) % 1 < 0.5 else -1
        elif wave == "saw":
            val = 2 * ((t * freq) % 1) - 1
        else:
            val = math.sin(2 * math.pi * freq * t)
        s = int(val * volume * env * 32767)
        s = max(-32768, min(32767, s))
        buf += s.to_bytes(2, "little", signed=True)
    return pygame.mixer.Sound(buffer=bytes(buf))


def make_noise(duration, volume=0.4):
    sample_rate = 22050
    n = int(sample_rate * duration)
    buf = bytearray()
    for i in range(n):
        env = (1.0 - i / n) ** 2
        s = int(random.uniform(-1, 1) * volume * env * 32767)
        s = max(-32768, min(32767, s))
        buf += s.to_bytes(2, "little", signed=True)
    return pygame.mixer.Sound(buffer=bytes(buf))


def make_music_loop():
    sample_rate = 22050
    notes = [110, 138.6, 164.8, 138.6]
    note_dur = 0.5
    buf = bytearray()
    for freq in notes:
        n = int(sample_rate * note_dur)
        for i in range(n):
            t = i / sample_rate
            env = min(1.0, i / (sample_rate * 0.05)) * (1.0 - i / n) ** 0.7
            val = math.sin(2 * math.pi * freq * t) + 0.3 * math.sin(2 * math.pi * freq * 2 * t)
            s = int(val * 0.15 * env * 32767)
            s = max(-32768, min(32767, s))
            buf += s.to_bytes(2, "little", signed=True)
    return pygame.mixer.Sound(buffer=bytes(buf))


